DATABASE_URL="postgresql://user:password@localhost:5432/physics_tutor"
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Cron job auth (used by cron-job.org to call /api/cron/* endpoints)
# Generate with: openssl rand -base64 32
CRON_SECRET="your-cron-secret-here"

# Piston-compatible sandbox for running chat code blocks, e.g.
# https://piston.example.com/api/v2/execute. Unset means code execution is off
# and the Run buttons are hidden (the public emkc.org instance is allow-list
# only and answers 401).
CODE_EXEC_API_URL=""

# Extra recipients for abuse/alert staff emails, comma separated
ABUSE_ALERT_EMAILS="you@example.com"
# User messages per hour that trigger an abnormal-volume alert (default 60)
MESSAGE_VOLUME_ALERT_THRESHOLD="60"
