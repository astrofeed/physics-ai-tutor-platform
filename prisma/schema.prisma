generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TA
  PROFESSOR
  ADMIN
}

enum QuestionType {
  MC
  NUMERIC
  FREE_RESPONSE
}

enum ToleranceUnit {
  ABSOLUTE
  PERCENT
}

enum AssignmentType {
  QUIZ
  FILE_UPLOAD
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  studentId     String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(STUDENT)
  isBanned      Boolean   @default(false)
  isRestricted  Boolean   @default(false)
  isVerified    Boolean   @default(false)
  bannedAt      DateTime?
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  conversations Conversation[]
  conversationFolders ConversationFolder[]
  submissions   Submission[]
  gradedSubmissions Submission[] @relation("GradedBy")
  createdAssignments Assignment[] @relation("CreatedBy")
  publishedAssignments Assignment[] @relation("PublishedBy")
  auditLogs     AuditLog[]
  generatedProblemSets ProblemSet[] @relation("GeneratedBy")
  notifications NotificationRead[]
  createdNotifications Notification[] @relation("NotificationCreatedBy")
  examModeToggles ExamMode[] @relation("ExamModeToggledBy")
  gradeAppeals    GradeAppeal[]    @relation("AppealStudent")
  appealMessages  AppealMessage[]  @relation("AppealMessageAuthor")
  activities      UserActivity[]
  createdEmailTemplates  EmailTemplate[]
  createdScheduledEmails ScheduledEmail[]
  passwordResetTokens    PasswordResetToken[]
  uploadEvents           UploadEvent[]
  uploadedFiles          UploadedFile[]
  rateLimitHits          RateLimitHit[]
  confirmedAnswerKeys    AssignmentQuestion[] @relation("KeyConfirmedBy")
  presentationRubrics    PresentationRubric[] @relation("RubricUpdatedBy")
  presentationGradingJobs PresentationGradingJob[] @relation("PresentationJobCreatedBy")
  reportRubrics    ReportRubric[]     @relation("ReportRubricUpdatedBy")
  reportGradingJobs ReportGradingJob[] @relation("ReportJobCreatedBy")
}

enum ReportJobStatus {
  QUEUED
  GRADING
  DONE
  FAILED
}

/// Shared written-report grading instructions. Versioned exactly like
/// PresentationRubric: each save is a new row; jobs keep the version they
/// were graded with.
model ReportRubric {
  id          String   @id @default(cuid())
  version     Int      @unique
  content     String   @db.Text
  updatedById String
  createdAt   DateTime @default(now())

  updatedBy User               @relation("ReportRubricUpdatedBy", fields: [updatedById], references: [id])
  jobs      ReportGradingJob[]
}

model ReportGradingJob {
  id      String          @id @default(cuid())
  title   String
  /// Author names, free text — staff search by this.
  authors String?
  status  ReportJobStatus @default(QUEUED)
  error   String?         @db.Text

  /// Blob URL is temporary: cleared after grading so no report file is retained.
  reportBlobUrl  String?
  reportFilename String?
  /// A report the grader pasted directly instead of uploading a PDF.
  reportText     String? @db.Text

  /// Structured summary/comments/questions result (raw JSON string).
  resultJson String? @db.Text

  model             String?
  reasoningEffort   String    @default("high")
  gradingStartedAt  DateTime?
  gradingDurationMs Int?

  rubricId    String
  createdById String
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  createdBy User         @relation("ReportJobCreatedBy", fields: [createdById], references: [id])
  rubric    ReportRubric @relation(fields: [rubricId], references: [id])

  @@index([rubricId])
  @@index([status, createdAt])
  @@index([createdById, createdAt])
}

enum PresentationJobStatus {
  QUEUED
  TRANSCRIBING
  GRADING
  DONE
  FAILED
}

/// Shared presentation-grading rubric. Each save creates a new row; the
/// highest version is the current rubric. Jobs reference the version they
/// were graded with, so rubric edits never change existing results.
model PresentationRubric {
  id          String   @id @default(cuid())
  version     Int      @unique
  content     String   @db.Text
  updatedById String
  createdAt   DateTime @default(now())

  updatedBy User                     @relation("RubricUpdatedBy", fields: [updatedById], references: [id])
  jobs      PresentationGradingJob[]
}

model PresentationGradingJob {
  id         String                @id @default(cuid())
  topic      String
  /// Presenter names, free text — the TA searches by this right after a talk.
  presenters String?
  track      String?
  condition String?
  status    PresentationJobStatus @default(QUEUED)
  error     String?               @db.Text

  /// Blob URLs are temporary: cleared after processing so no media is retained.
  audioBlobUrl  String?
  slidesBlobUrl String?
  slidesFilename String?

  transcript String? @db.Text
  slidesText String? @db.Text

  partIOutput  String? @db.Text
  partIIOutput String? @db.Text
  /// The one-line machine-readable scorecard emitted by the rubric (raw JSON string).
  summaryJson  String? @db.Text
  totalScore   Decimal? @db.Decimal(10, 2)

  model             String?
  reasoningEffort   String   @default("high")
  gradingStartedAt  DateTime?
  gradingDurationMs Int?

  rubricId    String
  createdById String
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  createdBy User               @relation("PresentationJobCreatedBy", fields: [createdById], references: [id])
  rubric    PresentationRubric @relation(fields: [rubricId], references: [id])

  @@index([rubricId])
  @@index([status, createdAt])
  @@index([createdById, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  folderId  String?
  title     String    @default("New Chat")
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder   ConversationFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([userId, isDeleted, updatedAt])
  @@index([folderId])
}

model ConversationFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([userId, createdAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // "user" or "assistant"
  content        String   @db.Text
  imageUrls      String[] @default([])
  model          String?  // "gpt-5-mini" or "claude-haiku-4.5"
  mode           String?  // "normal" or "socratic"
  createdAt      DateTime @default(now())

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]

  @@index([conversationId, createdAt])
}

/// Documents (PDF / Markdown / plain text) attached to a chat message.
/// `extractedText` holds the text handed to the model, so later turns in the
/// same conversation reuse it without re-fetching or re-parsing the file.
model MessageAttachment {
  id            String   @id @default(cuid())
  messageId     String
  url           String
  filename      String
  mimeType      String
  sizeBytes     Int
  extractedText String?  @db.Text
  truncated     Boolean  @default(false)
  createdAt     DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

/// One row per issued upload token, used to enforce per-user upload quotas
/// (images per hour, documents per day) across serverless instances.
model UploadEvent {
  id        String   @id @default(cuid())
  userId    String
  kind      String   // "image" | "document"
  mimeType  String
  filename  String
  sizeBytes Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
}

/// One row per file accepted by `/api/upload`. Files are never served as public
/// static assets: clients only ever see `/api/files/<id>`, which checks access
/// before streaming the bytes. `visibility` is `PUBLIC` for staff-authored
/// material (question images, feedback images) and `RESTRICTED` for anything a
/// student uploads, which only the uploader and course staff may read.
model UploadedFile {
  id          String    @id @default(cuid())
  userId      String
  filename    String
  mimeType    String
  sizeBytes   Int
  /// Local path relative to the private uploads dir, when stored on disk.
  storagePath String?
  /// Remote object URL (e.g. Vercel Blob), when stored off-box.
  storageUrl  String?
  visibility  String    @default("RESTRICTED") // "PUBLIC" | "RESTRICTED"
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Unauthenticated auth attempts per client IP (hashed), used to rate limit
/// signups and verification-email resends.
model AuthAttempt {
  id        String   @id @default(cuid())
  kind      String // "register" | "verify_resend"
  ipHash    String
  createdAt DateTime @default(now())

  @@index([kind, ipHash, createdAt])
}

/// One row per rate-limited action attempt. Counting rows in the window keeps
/// limits correct across serverless instances, unlike per-process counters.
model RateLimitHit {
  id        String   @id @default(cuid())
  userId    String
  action    String // "run_code"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, action, createdAt])
}

model Course {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  semester    String
  createdAt   DateTime @default(now())

  assignments Assignment[]
}

model Assignment {
  id          String         @id @default(cuid())
  courseId     String?
  title       String
  description String?        @db.Text
  dueDate     DateTime?
  type        AssignmentType
  totalPoints Float          @default(100)
  published        Boolean        @default(false)
  lockAfterSubmit  Boolean        @default(false)
  isDeleted        Boolean        @default(false)
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  pdfUrl           String?
  createdById      String
  publishedById    String?
  scheduledPublishAt DateTime?
  notifyOnPublish    Boolean   @default(false)
  // Set for assignments built from AI-generated problems: their answer keys are
  // written by a model and are wrong often enough that every question needs a
  // human confirmation before students can see it.
  requiresKeyReview  Boolean   @default(false)

  course      Course?        @relation(fields: [courseId], references: [id])
  createdBy   User           @relation("CreatedBy", fields: [createdById], references: [id])
  publishedBy User?          @relation("PublishedBy", fields: [publishedById], references: [id])
  questions       AssignmentQuestion[]
  submissions     Submission[]
  scheduledEmails ScheduledEmail[]
}

model AssignmentQuestion {
  id            String       @id @default(cuid())
  assignmentId  String
  questionText  String       @db.Text
  questionType  QuestionType
  options       Json?        // JSON array for MC options
  correctAnswer String?
  // Extra answers that also score full marks (an MC key opened up to a second
  // option, or a second acceptable numeric value). `correctAnswer` stays the
  // canonical one that is shown as "the" answer.
  alsoAcceptedAnswers String[] @default([])
  points        Float        @default(10)
  order         Int          @default(0)
  // NUMERIC only: how far a student answer may deviate from correctAnswer and
  // still be auto-graded correct. null = exact match.
  tolerance     Decimal?     @db.Decimal(12, 6)
  toleranceUnit ToleranceUnit @default(ABSOLUTE)
  diagram       Json?        // { type: "svg" | "mermaid", content: string }
  imageUrl      String?
  // Who signed off on this question's answer key, and when. Cleared whenever the
  // key changes, so a confirmation can never outlive the answer it approved.
  keyConfirmedAt   DateTime?
  keyConfirmedById String?

  assignment Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  keyConfirmedBy User?        @relation("KeyConfirmedBy", fields: [keyConfirmedById], references: [id], onDelete: SetNull)
  answers    SubmissionAnswer[]
  rubrics    Rubric[]

  @@index([keyConfirmedById])
}

model Submission {
  id           String    @id @default(cuid())
  assignmentId String
  userId       String
  /// The student's own upload (FILE_UPLOAD assignments). Graders must never
  /// write here — their attachment goes to `feedbackFileUrl`.
  fileUrl      String?
  /// A file the grader attaches to their feedback, shown to the student
  /// alongside the grade.
  feedbackFileUrl String?
  submittedAt  DateTime  @default(now())
  totalScore   Float?
  gradedAt     DateTime?
  gradedById   String?
  isDraft          Boolean   @default(false)
  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?
  overallFeedback  String?   @db.Text
  /// Lateness is decided once, at submit time, against the deadline then in
  /// force — later due-date edits must not re-label existing submissions.
  isLate               Boolean   @default(false)
  dueDateAtSubmission  DateTime?
  /// In-progress grading total, visible to staff only. `totalScore` is written
  /// once grading is finalized, which is what students are ever shown.
  draftTotalScore      Float?

  assignment Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  gradedBy   User?              @relation("GradedBy", fields: [gradedById], references: [id])
  answers    SubmissionAnswer[]

  @@index([userId, submittedAt])
  @@index([assignmentId])
  @@index([assignmentId, userId])
}

model SubmissionAnswer {
  id           String  @id @default(cuid())
  submissionId String
  questionId   String
  answer           String? @db.Text
  answerImageUrls  Json?   // String[] - up to 3 image URLs attached by student
  score            Float?
  feedback         String? @db.Text
  feedbackImageUrls Json?   // String[] - up to 3 image URLs for feedback
  autoGraded       Boolean @default(false)
  // AI pre-grade: a suggestion only. It never contributes to a score until a
  // grader accepts it, which copies it into score/feedback.
  aiSuggestedScore    Decimal?  @db.Decimal(10, 2)
  aiSuggestedFeedback String?   @db.Text
  aiSuggestedAt       DateTime?

  submission Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   AssignmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  appeals    GradeAppeal[]

  @@index([submissionId])
  @@index([questionId])
}

model Rubric {
  id          String @id @default(cuid())
  questionId  String
  description String @db.Text
  points      Float

  question AssignmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model AIConfig {
  id           String   @id @default(cuid())
  provider     String   @default("openai") // "openai" or "anthropic"
  model        String   @default("gpt-5-mini")
  systemPrompt String?  @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model ProblemSet {
  id           String   @id @default(cuid())
  topic        String
  difficulty   Int
  questionType String
  createdById  String
  createdAt    DateTime @default(now())

  createdBy User              @relation("GeneratedBy", fields: [createdById], references: [id])
  problems  GeneratedProblem[]
}

model GeneratedProblem {
  id            String  @id @default(cuid())
  problemSetId  String
  questionText  String  @db.Text
  questionType  String
  options       Json?
  correctAnswer String
  solution      String  @db.Text
  points        Float   @default(10)
  diagram       Json?

  problemSet ProblemSet @relation(fields: [problemSetId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // "rate_limit_hit", "content_flag", "abuse_detected", "ban", "unban", "restrict", "unrestrict"
  details   Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Notification {
  id          String   @id @default(cuid())
  title       String
  message     String   @db.Text
  createdById String
  isGlobal    Boolean  @default(true)
  /// Roles allowed to see this notification. Empty means everyone.
  audienceRoles Role[]
  createdAt   DateTime @default(now())

  createdBy User               @relation("NotificationCreatedBy", fields: [createdById], references: [id])
  reads     NotificationRead[]
}

model NotificationRead {
  id             String   @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
}

model ExamMode {
  id          String   @id @default(cuid())
  isActive    Boolean  @default(false)
  message     String?
  toggledById String
  toggledAt   DateTime @default(now())

  toggledBy User @relation("ExamModeToggledBy", fields: [toggledById], references: [id])
}

enum AppealStatus {
  OPEN
  RESOLVED
  REJECTED
}

model GradeAppeal {
  id               String       @id @default(cuid())
  submissionAnswerId String
  studentId        String
  reason           String       @db.Text
  imageUrls        Json?        // String[] - up to 3 image URLs
  status           AppealStatus @default(OPEN)
  isDeleted        Boolean      @default(false)
  deletedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  submissionAnswer SubmissionAnswer @relation(fields: [submissionAnswerId], references: [id], onDelete: Cascade)
  student          User             @relation("AppealStudent", fields: [studentId], references: [id])
  messages         AppealMessage[]

  @@unique([submissionAnswerId, studentId])
  @@index([studentId])
}

model AppealMessage {
  id        String   @id @default(cuid())
  appealId  String
  userId    String
  content   String   @db.Text
  imageUrls Json?    // String[] - up to 3 image URLs
  createdAt DateTime @default(now())

  appeal GradeAppeal @relation(fields: [appealId], references: [id], onDelete: Cascade)
  user   User        @relation("AppealMessageAuthor", fields: [userId], references: [id])

  @@index([appealId, createdAt])
}

model UserActivity {
  id         String   @id @default(cuid())
  userId     String
  category   String
  detail     String?
  durationMs Int?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, category, createdAt])
}

model EmailTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  subject     String
  message     String   @db.Text
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([category])
}

enum ScheduledEmailStatus {
  PENDING
  SENT
  CANCELLED
  FAILED
}

model ScheduledEmail {
  id                 String               @id @default(cuid())
  subject            String
  message            String               @db.Text
  recipientIds       String[]
  status             ScheduledEmailStatus @default(PENDING)
  scheduledAt        DateTime
  sentAt             DateTime?
  cancelledAt        DateTime?
  error              String?              @db.Text
  createNotification Boolean              @default(false)
  /// Roles the generated in-app notification is visible to. Empty means everyone.
  audienceRoles      Role[]
  assignmentId       String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  createdById        String

  createdBy  User        @relation(fields: [createdById], references: [id])
  assignment Assignment? @relation(fields: [assignmentId], references: [id])

  @@index([status, scheduledAt])
  @@index([createdById])
  @@index([assignmentId])
}
